# Copy this file to .env only when you receive approved API credentials from a ride provider.
# Never put real secret keys in frontend files.
PORT=3000
OLA_API_KEY=
UBER_API_KEY=

# Rapido requires a valid bearer token and customer/device details.
RAPIDO_TOKEN=
RAPIDO_DEVICE_ID=
RAPIDO_CUSTOMER_ID=
RAPIDO_SERVICE_TYPE=57370b61a6855d70057417d1
RAPIDO_PAYMENT_TYPE=paytm
RAPIDO_LATITUDE=26.9124
RAPIDO_LONGITUDE=75.7873
RAPIDO_APPVERSION=73
